# Copy to sbx.yaml. Every value here is optional; omitted keys keep the defaults.
# Flags override environment variables, which override this file.
addr: 127.0.0.1:8080
data_dir: data
backend: docker
log_level: info
# Web UI at /ui/. It is static; sign-in uses an API key.
dashboard: true

kata:
  # Docker runtime name and the containerd shim it should point at.
  runtime: kata
  runtime_type: io.containerd.kata.v2

firecracker:
  # Empty bin and kernel use data/firecracker/ after `sbx setup firecracker --apply`.
  # bin: data/firecracker/firecracker
  # kernel: data/firecracker/vmlinux
  # jailer: data/firecracker/jailer
  uid: 123
  gid: 123

docker:
  host: /var/run/docker.sock
  gvisor_runtime: runsc
  read_only_rootfs: true
  sandbox_uid: 1000
  sandbox_gid: 1000
  # sandbox_root: true
  # read_only_rootfs must also be false before apk or apt can install packages.
  # Path to the static sbx-agent binary. Empty, or a missing sibling of the
  # sbx binary, keeps exec and files on the shell path inside the image.
  # agent_bin: /usr/local/bin/sbx-agent

limits:
  default_ttl_seconds: 300
  max_ttl_seconds: 86400
  default_cpu: 1
  default_memory_mb: 512
  default_disk_mb: 1024
  default_pids: 256
  max_sandboxes_per_key: 20
  max_sandboxes: 100
  requests_per_minute: 1200

auth:
  # Optional. Pin a backend on a template via POST /v1/templates {"backend":"gvisor"}.
# sbx setup gvisor|kata|firecracker prepares host assets. --apply downloads them.
# Optional. When set, the first boot uses this key instead of generating one.
  # bootstrap_key: sbx_replace_me

# Sandboxes stay offline until default_mode is full or allow.
# See docs/NETWORK.md for previews, Traefik, Caddy, and Dokploy.
network:
  default_mode: none
  block_private: true
  block_metadata: true
  # private_allow:
  #   - 10.8.0.0/24
  dns:
    - 1.1.1.1
    - 8.8.8.8
  ipv6: auto
  # egress_allow:
  #   - example.com
  # egress_deny:
  #   - example.net
  # default_egress_kbps: 10000
  # default_max_connections: 128
  # preview_domain: sbx.example.com
  # public_url: https://api.example.com
  allow_public_previews: true
  # Route preview hosts by X-Forwarded-Host. Only behind a proxy that sets it.
  trust_forwarded_host: false
  preview_max_streams: 64

# Template builds run their steps as root in Docker's builder, with the
# daemon's default network. Only admin keys can request one unless
# allow_sandbox_keys is true. Built images are cached by content hash.
# Images no template or live sandbox needs are removed after
# retain_unused_seconds without use (0 keeps them forever).
builds:
  allow_sandbox_keys: false
  timeout_seconds: 1200
  retain_unused_seconds: 604800

# Credentials for private image registries, used for sandbox images and
# template bases for every key. A key's own credential for the same server
# (POST /v1/keys "registries") takes precedence. Use password, password_env,
# or password_file; identity_token replaces username and password.
# registries:
#   - server: ghcr.io
#     username: deploy-bot
#     password_env: GHCR_TOKEN
#   - server: docker.io
#     username: acme
#     password_file: /run/secrets/dockerhub
