{
  "name": "@torstendittmann/sbx",
  "version": "0.2.0",
  "description": "TypeScript client for the sbx sandbox API. Runs on Node and Bun.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TorstenDittmann/sbx.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://github.com/TorstenDittmann/sbx/tree/main/sdk/typescript",
  "bugs": "https://github.com/TorstenDittmann/sbx/issues",
  "keywords": ["sbx", "sandbox"],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:bun": "bun test test"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  }
}
