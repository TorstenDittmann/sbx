amends "https://orch.torsten.work/pkl/v1alpha1/Application.pkl"

// sbx.torsten.work, served by orch as a static site. Requires orch v0.1.14 or
// newer. Build first with `./build.sh`; the deploy workflow is
// .github/workflows/website-deploy.yml.

name = "sbx-website"

services {
  ["web"] {
    // Unknown paths get dist/404.html with status 404.
    static = new Static { dir = "dist" }
    http { domains { "sbx.torsten.work" } }
  }
}
