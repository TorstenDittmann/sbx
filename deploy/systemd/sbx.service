[Unit]
Description=sbx sandbox server
After=docker.service
Requires=docker.service

[Service]
# Defaults apply with no config file. To override them, install
# /etc/sbx/sbx.yaml from sbx.yaml.example and add --config to ExecStart.
ExecStart=/usr/local/bin/sbx serve
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
